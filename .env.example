# Copy to .env (ignored by Git). Credentials must have CNMC SIPS download permission.
# Never commit secrets or download URLs. The synchronizer is opt-in: --profile sips.
SIPS_API_URL=https://api.cnmc.gob.es
SIPS_CONSUMER_KEY=
SIPS_CONSUMER_SECRET=
# Alternative: path INSIDE the sips-sync container to a mounted secret file.
SIPS_CONSUMER_SECRET_FILE=
SIPS_NIF_EMPRESA=
# Use the authorized procedure ID from CNMC; do not guess it.
SIPS_PROCEDURE_ID=
# Optional comma-separated exact CNMC tipoFichero values; empty = CSV/ZIP in the procedure.
SIPS_FILE_TYPES=
SIPS_POLL_SECONDS=3600
SIPS_MAX_DOWNLOAD_BYTES=53687091200
SIPS_MAX_UNPACKED_BYTES=536870912000
